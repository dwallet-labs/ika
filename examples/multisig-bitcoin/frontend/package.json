{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"setup": "(test -d ../contract && pnpm create-summaries || echo 'Skipping create-summaries') && (test -f scripts/install_script.bash && bash scripts/install_script.bash || echo 'Skipping install script') && (test -f sui-codegen.config.ts && pnpm sui-ts-codegen generate || echo 'Skipping codegen')",
		"predev": "pnpm run setup",
		"dev": "next dev --webpack",
		"prebuild": "pnpm run setup",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint",
		"create-summaries": "cd ../contract && sui move summary",
		"publish": "bash scripts/publish_and_update.bash",
		"update-address": "bash scripts/update_published_address.bash"
	},
	"dependencies": {
		"@bitcoinerlab/secp256k1": "^1.2.0",
		"@ika.xyz/sdk": "workspace:*",
		"@mysten/codegen": "catalog:",
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@mysten/sui": "catalog:",
		"@noble/curves": "catalog:",
		"@noble/hashes": "catalog:",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-query": "catalog:",
		"@types/bitcoinjs-lib": "^5.0.4",
		"bitcoinjs-lib": "^7.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"comlink": "^4.4.2",
		"lucide-react": "^0.555.0",
		"next": "catalog:",
		"next-themes": "^0.4.6",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tiny-invariant": "^1.3.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"eslint": "^9",
		"eslint-config-next": "16.0.1",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
