{
	"extends": "./tsconfig.shared.json",
	"include": ["src"],
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		// TypeScript 6 no longer auto-includes @types packages; process usage needs node globals
		"types": ["node"],
		// match output dir to input dir. e.g. dist/index instead of dist/src/index
		"rootDir": "src",
		"outDir": "dist/types",
		"emitDeclarationOnly": false
	}
}
